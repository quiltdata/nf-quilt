{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    ":dependencyDashboard",
    ":semanticPrefixFixDepsChoreOthers",
    ":ignoreModulesAndTests",
    "replacements:all",
    "workarounds:all",
    "helpers:pinGitHubActionDigests"
  ],
  "constraints": {
    "java": "21"
  },
  "packageRules": [
    {
      "description": "Keep Renovate's own JDK at 21: io.nextflow.nextflow-plugin requires a Java 21 toolchain",
      "matchFileNames": ["renovate.json"],
      "matchDepNames": ["java"],
      "enabled": false
    },
    {
      "description": "One PR for all minor/patch/digest updates",
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"],
      "groupName": "minor dependencies",
      "groupSlug": "minor"
    },
    {
      "description": "One PR for all major updates",
      "matchUpdateTypes": ["major"],
      "groupName": "major dependencies",
      "groupSlug": "major"
    }
  ]
}
